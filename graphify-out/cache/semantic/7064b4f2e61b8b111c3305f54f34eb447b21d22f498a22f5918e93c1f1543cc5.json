{"nodes": [{"id": "context_architecture_no_absolute_thresholds", "label": "No Absolute Thresholds (Percentile Self-Calibration)", "file_type": "rationale", "source_file": "context/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every feature is a percentile of the session's own expanding distribution so the same code reads NIFTY, BANKNIFTY or stocks without retuning \u2014 validated at scale on BankNifty and Sensex where the band-fade edge generalized (56/64/58% WR)."}, {"id": "context_architecture_causality_invariant", "label": "Causality Invariant (no future bars; replay==live)", "file_type": "rationale", "source_file": "context/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No feature may use future bars (expanding ranks only) so the replay engine is identically usable as the live engine \u2014 a code-review pass caught a gex_run IV lookahead that had produced artificially low 0.046 IVs."}, {"id": "context_architecture_gamma_layer_separation", "label": "Gamma Layer Separation Invariant", "file_type": "rationale", "source_file": "context/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gamma layer never modifies base signal logic, confidence or wording so backtesting can make an honest with/without comparison; enforced by diffing the byte-identical base event stream before and after gamma changes."}, {"id": "context_architecture_ui_renders_engine_decides", "label": "UI Renders, Engine Decides", "file_type": "rationale", "source_file": "context/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any new analytic belongs in engine.py; the engine emits structured data plus 'HEAD \u2014 evidence' strings and the UI must not re-derive analytics from raw bars, keeping a single source of truth for signals."}, {"id": "context_architecture_no_order_execution", "label": "No Order Execution (Signal-only, permanent)", "file_type": "rationale", "source_file": "context/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool never places, modifies or cancels orders \u2014 permanently signal-only, a single-operator local instrument bound to 127.0.0.1."}], "edges": [{"source": "context_architecture_gamma_layer_separation", "target": "engine_gammalayer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}, {"source": "context_architecture_no_absolute_thresholds", "target": "context_project_overview_tapemap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}, {"source": "context_architecture_causality_invariant", "target": "context_logic_plain_english_per_bar_features", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}, {"source": "context_architecture_gamma_layer_separation", "target": "context_logic_plain_english_gamma_regimes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}, {"source": "context_architecture_ui_renders_engine_decides", "target": "context_progress_tracker_option_chain_analyser", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}, {"source": "context_architecture_no_order_execution", "target": "context_project_overview_tapemap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "architecture_invariants", "label": "TapeMap architecture invariants", "nodes": ["context_architecture_no_absolute_thresholds", "context_architecture_causality_invariant", "context_architecture_gamma_layer_separation", "context_architecture_ui_renders_engine_decides", "context_architecture_no_order_execution"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "context/architecture.md"}]}