//@version=6
indicator("TapeMap — Band Reversal", overlay=true, max_labels_count=500, max_lines_count=300)

// =====================================================================
// TapeMap Band-Reversal — the backtest-VALIDATED core.
// On 55 unseen NIFTY days / 219 tags, fading a ±2sigma band tag won ~56%
// (best base edge we found). This script is the price-structure half only.
//
// NOT in Pine (it cannot get NSE option OI): the gamma/OI layers — writer
// scores, squeeze, and especially the NEGATIVE-GAMMA VETO ("don't fade an
// extreme when dealers are short gamma; it breaks and rallies"). Get that
// from the TapeMap app. Pine says WHERE (extreme printed, look now);
// the app says WHETHER (fade it, or stand aside).
//
// Method encoded here:
//   * session VWAP + -/+1/2/3 sigma bands (same math as the engine)
//   * fade a -2s (long) / +2s (short) tag; re-arm only after price returns
//     inside +/-1s; deeper 3s tag = higher conviction
//   * shade the "pin" zone (inside +/-1s with flat bands) = don't-trade
//   * +/-1R scalp target & stop (the tag is a ~1R scalp, NOT a ride to VWAP)
//   * prior-day pivots; alerts on every tag
// =====================================================================

showPin = input.bool(true, "Shade pin zone (inside +/-1s = don't-trade)")

// ---------- session-anchored VWAP + sigma bands
dayChg = ta.change(time("D"))
newSes = timeframe.isintraday and (na(time[1]) or dayChg != 0)
var float cPV = 0.0
var float cV  = 0.0
var float cV2 = 0.0
tp = hlc3
if newSes
    cPV := 0.0
    cV  := 0.0
    cV2 := 0.0
cPV += tp * volume
cV  += volume
vwap = cV > 0 ? cPV / cV : tp
cV2 += volume * math.pow(tp - vwap, 2)
sd = cV > 0 ? math.sqrt(cV2 / cV) : 0.0

u1 = vwap + sd
d1 = vwap - sd
u2 = vwap + 2.0 * sd
d2 = vwap - 2.0 * sd
u3 = vwap + 3.0 * sd
d3 = vwap - 3.0 * sd

plot(vwap, "VWAP", color.new(color.gray, 0), 2)
p1u = plot(u1, "+1s", color.new(color.teal, 60))
p1d = plot(d1, "-1s", color.new(color.teal, 60))
p2u = plot(u2, "+2s", color.new(color.orange, 30))
p2d = plot(d2, "-2s", color.new(color.orange, 30))
p3u = plot(u3, "+3s", color.new(color.red, 30))
p3d = plot(d3, "-3s", color.new(color.red, 30))
fill(p1u, p1d, color.new(color.teal, 92))
fill(p2u, p3u, color.new(color.red, 93))
fill(p2d, p3d, color.new(color.red, 93))

// ---------- z-score + pin filter (flat bands + inside +/-1s = coil/pin)
z = sd > 0 ? (close - vwap) / sd : 0.0
bw = u2 - d2
bwAvg = ta.sma(bw, 30)
bwFlat = not na(bwAvg) and bw <= bwAvg
inPin = math.abs(z) < 1 and bwFlat
bgcolor(showPin and inPin ? color.new(color.gray, 90) : na, title="Pin zone")

// ---------- band-reversal signals (re-arm after price returns inside +/-1s)
var bool armLo = true
var bool armHi = true
if math.abs(z) < 1
    armLo := true
    armHi := true
longTag  = armLo and low  <= d2 and not inPin
shortTag = armHi and high >= u2 and not inPin
if longTag
    armLo := false
if shortTag
    armHi := false
deepLong  = longTag  and low  <= d3
deepShort = shortTag and high >= u3

plotshape(longTag and not deepLong,   "-2s long",  shape.triangleup,   location.belowbar, color.new(color.lime, 0),   size=size.small)
plotshape(shortTag and not deepShort, "+2s short", shape.triangledown, location.abovebar, color.new(color.orange, 0), size=size.small)
plotshape(deepLong,  "-3s long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.normal)
plotshape(deepShort, "+3s short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.normal)

// ---------- prior-day pivots
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
P  = (pdh + pdl + pdc) / 3.0
R1 = 2.0 * P - pdl
S1 = 2.0 * P - pdh
plot(P,  "Pivot", color.new(color.blue, 40), 1)
plot(R1, "R1",    color.new(color.maroon, 60), 1)
plot(S1, "S1",    color.new(color.maroon, 60), 1)

// ---------- alerts
alertcondition(longTag,  "Band -2s reversal (long)",  "NIFTY tagged -2s - fade-long setup; check gamma veto in app")
alertcondition(shortTag, "Band +2s reversal (short)", "NIFTY tagged +2s - fade-short setup; check gamma veto in app")
alertcondition(deepLong or deepShort, "Deep 3s tag",  "NIFTY tagged 3s - high-conviction reversal")
