# secrets — never commit a broker API token
.dhan_token
.upstox_token
.upstox_token.bak
# the Upstox app's api_key/api_secret pair, read by upstox_auth.py
.upstox_app.json

# live-recorded chain snapshots (200MB+/day, over GitHub's file limit)
data/chain/
# book-detector rows (measured ~170MB/day at full scope, same problem)
data/senses/
# the ladder record (tape_log.py): GoCharting's per-price prints as posted by
# orderflow-desk, ~0.3MB/day, not refetchable from any broker. Two forward
# populations in their own files (bars; the extension's marks), never pooled.
data/tape/
# the book record (book_log.py): every changed frame of each index future off
# the Upstox socket, ~60 MB/day [I, measured day one], not refetchable.
data/book/
# surface fit forward log (one line per successful fit, per index, per day --
# desk_log.py) and the desk verdict-transition log (a single running file,
# same module). Neither is broker-sourced or refetchable; eod_capture.py's
# capture_desk_record preserves each day's copy into data/backtest/ instead.
data/surface/
data/desk_log.jsonl
# war-map sequence transitions (sequence.py) -- its OWN forward population,
# one file per day, never pooled with any of the above
data/warmap/
# NSE participant-wise OI EOD files (driver.py) -- refetchable public CSVs
data/participant/
# the paper desk's book, trades and decision journal (trader.py) -- runtime
# state + its own forward populations, never pooled with any other record
data/paper_desk/
# the day's RAM-only series, written down so a post-close restart still shows
# the session (day_state.py). Per-day runtime state, same class as
# data/paper_desk/state.json -- NOT a forward record and never scored.
data/day_state/
# the toxicity morning REBUILT from 1-minute bars (vpin.from_bars). Derived,
# regenerable from the same bars any time, and rewritten on every start.
# data/vpin_log.jsonl is the forward record it must never be confused with.
data/vpin_backfill.jsonl

# THE LIVE FORWARD RECORDS are never tracked (2026-09-28): a tracked, modified record can be
# overwritten by any git stash / reset / whole-tree checkout. data/trigger_log.jsonl was tracked
# since August against the rule in CLAUDE.md and HANDOFF-OPERATOR.md §6; untracked here, file kept.
data/trigger_log.jsonl
data/vpin_log.jsonl
data/vpin_fast.jsonl

# caches / local tooling state
__pycache__/
*.pyc
.pytest_cache/
.claude-flow/
.claude/settings.local.json

# server logs. `_srv.log` / `_srv.err` are one debugging run's captured stdout
# and stderr — the same lines the terminal already showed, stale the moment the
# next run starts, and different on every machine.
*.log
_srv.err

# the design hook's per-machine runtime state: a PID, a port and a session
# token for a server that has already exited by the time anyone reads the file.
# The CRITIQUE snapshots under .impeccable/critique/ are the output worth
# keeping and stay tracked.
**/.impeccable/live/
**/.impeccable/hook.cache.json
**/.impeccable/config.local.json

# local Dhan client id (numeric account id)
.dhan_client

# local safety copies taken before a destructive run (e.g.
# trigger_log.jsonl.bak-before-backfill). The point of them is to exist on THIS
# machine while a rewrite is in flight; committing one would just be a second,
# staler copy of a file git already versions.
*.bak-*

# daily runtime caches (rebuilt automatically)
data/scrip_master.csv
data/stick_state.json
data/upstox_*.json
tapemap.log*
graphify-out/
.impeccable/
tape_desktop.png
data/fixtures-private/
ui-v2/tsconfig.tsbuildinfo

# agents' scratch caches (validate2 alone was 319MB of .pkl) -- never commit
**/scratch/_cache/
*.pkl
