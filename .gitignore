# secrets — never commit a broker API token
.dhan_token
.upstox_token
.upstox_token.bak
# the Upstox app's api_key/api_secret pair, read by upstox_auth.py
.upstox_app.json

# live-recorded chain snapshots (200MB+/day, over GitHub's file limit)
data/chain/
# book-detector rows (measured ~170MB/day at full scope, same problem)
data/senses/

# caches / local tooling state
__pycache__/
*.pyc
.pytest_cache/
.claude-flow/
.claude/settings.local.json

# server logs. `_srv.log` / `_srv.err` are one debugging run's captured stdout
# and stderr — the same lines the terminal already showed, stale the moment the
# next run starts, and different on every machine.
*.log
_srv.err

# the design hook's per-machine runtime state: a PID, a port and a session
# token for a server that has already exited by the time anyone reads the file.
# The CRITIQUE snapshots under .impeccable/critique/ are the output worth
# keeping and stay tracked.
**/.impeccable/live/
**/.impeccable/hook.cache.json
**/.impeccable/config.local.json

# local Dhan client id (numeric account id)
.dhan_client

# local safety copies taken before a destructive run (e.g.
# trigger_log.jsonl.bak-before-backfill). The point of them is to exist on THIS
# machine while a rewrite is in flight; committing one would just be a second,
# staler copy of a file git already versions.
*.bak-*

# daily runtime caches (rebuilt automatically)
data/scrip_master.csv
data/stick_state.json
data/upstox_*.json
